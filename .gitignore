# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# os
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# editors
.idea/
*.swp
*.swo
*~
# .vscode is committed on purpose: shared settings and recommended extensions
# are useful to keep. Ignore only the machine-specific parts.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# build tooling caches
.turbo/
.swc/
.eslintcache

# test output (coverage is already ignored above)
/playwright-report/
/test-results/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
